PORT=5555
SESSION_SECRET=your_session_secret_here
NODE_ENV=development

# Cách 1 (khuyến nghị): biến riêng từ Supabase Dashboard
DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your_database_password

# Cách 2: DATABASE_URL — encode dấu chấm trong user (postgres → postgres%2E)
# DATABASE_URL=postgresql://postgres%2EYOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
